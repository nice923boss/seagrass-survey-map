{
  "name": "seagrass-survey-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "海草調查點位資訊查詢地圖（靜態網站 / GitHub Pages）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch:data": "tsx scripts/fetch-surveys.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "papaparse": "^5.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.5.2",
    "google-auth-library": "^10.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
